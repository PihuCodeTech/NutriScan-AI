# Copy to .env for local development. In production set these in the host's secret store instead, with
# APP_ENV=prod, a NEW JWT_SECRET, an https PUBLIC_BASE_URL, explicit CORS_ORIGINS and a PostgreSQL DATABASE_URL
# (see "Production deployment" in README.md).

# ---- App ----
APP_ENV=dev
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated origins allowed to call the API from a browser. "*" is fine for local dev; in prod list the
# frontend's origin(s), e.g. https://app.example.com (the server logs a warning otherwise).
CORS_ORIGINS=*

# ---- Database ----
# Local dev / tests use SQLite (no setup). For Supabase (managed Postgres), use the SESSION POOLER URI from
# Supabase > Project Settings > Database > Connection string, pasted as is ("postgresql://" is switched to the
# async driver automatically). Not the https://<ref>.supabase.co project URL.
#   DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# TLS is verified against certs/supabase-ca.crt (Supabase's public root CA). Create the tables once:
#   alembic upgrade head
DATABASE_URL=sqlite+aiosqlite:///./nutriscan.db

# docker compose only: password of the bundled PostgreSQL (required; compose won't start without it)
# POSTGRES_PASSWORD=

# ---- Auth ----
# At least 32 random characters in prod: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# ---- Gemini (get a key at https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=
# false = Gemini Developer API: any key from AI Studio, whether it starts with "AIza" or "AQ.".
# true  = Vertex AI express mode: only for a key created in the Google Cloud console for Vertex AI.
# Not sure? Run `python scripts/smoke_gemini.py`: it tries both and tells you which one your key needs.
GEMINI_USE_VERTEX=false
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_S=30
# When a model is overloaded (503 "high demand") or times out, try the other model first for this many
# seconds instead of making every request wait on the struggling one. 0 = off.
GEMINI_COOLDOWN_S=120
# How hard Gemini 3 "thinks": minimal | low | medium | high (empty = model default). low = fast scans/chat.
GEMINI_THINKING_LEVEL=low

# ---- Mock mode: true = no Gemini key and no model download needed ----
MOCK_AI=false

# ---- Transfer-learned classifier ----
CLASSIFIER_ENABLED=true
CLASSIFIER_MODEL_ID=nateraw/food
CLASSIFIER_TOP_K=3

# ---- Uploads ----
MAX_UPLOAD_MB=8
STORAGE_DIR=./storage/uploads
# How long a signed photo URL stays valid (seconds)
MEDIA_URL_TTL_S=86400
# Throw-away guest accounts (and their photos) older than this are deleted
GUEST_RETENTION_DAYS=3

# ---- Limits ----
RATE_LIMIT_AI=20/minute
# Per client IP: password guessing and mass sign-ups
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=20/hour
CHAT_HISTORY_TURNS=20
CHAT_MAX_TOOL_ROUNDS=4

# ---- Web frontend (served at /app) ----
FRONTEND_DIR=./frontend

# ---- Monitoring and alerts (README, "Monitoring") ----
# Bearer token for GET /metrics (Prometheus text format). Empty = endpoint disabled.
METRICS_TOKEN=
# Slack or Discord incoming-webhook URL that receives alerts (also used by the backup service). Empty = alerts
# are only written to the log at level ERROR ("alert firing").
ALERT_WEBHOOK_URL=
# Re-send a still-firing alert every N minutes (0 = once)
ALERT_REPEAT_MIN=240
MONITOR_INTERVAL_S=60
# Guest cleanup runs at startup and then every N hours
GUEST_CLEANUP_INTERVAL_H=24

# ---- Backups (docker compose "backup" service) ----
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
# Host folder for dumps and photo archives (copy it off this machine as well)
# BACKUP_HOST_DIR=./backups
# Dead-man's switch, e.g. a healthchecks.io check URL: pinged after every good backup, so you are alerted when
# backups stop happening at all, not only when one fails.
BACKUP_HEARTBEAT_URL=
