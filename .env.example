# ---- App ----
APP_ENV=dev
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=*

# ---- Database ----
# Local dev / tests use SQLite (no setup). For Supabase (managed Postgres), use the SESSION POOLER URI from
# Supabase > Project Settings > Database > Connection string, pasted as is ("postgresql://" is switched to the
# async driver automatically). Not the https://<ref>.supabase.co project URL.
#   DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# TLS is verified against certs/supabase-ca.crt (Supabase's public root CA). Create the tables once:
#   alembic upgrade head
DATABASE_URL=sqlite+aiosqlite:///./nutriscan.db

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# ---- Gemini (get a key at https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=
# false = Gemini Developer API: any key from AI Studio, whether it starts with "AIza" or "AQ.".
# true  = Vertex AI express mode: only for a key created in the Google Cloud console for Vertex AI.
# Not sure? Run `python scripts/smoke_gemini.py`: it tries both and tells you which one your key needs.
GEMINI_USE_VERTEX=false
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_S=30
# How hard Gemini 3 "thinks": minimal | low | medium | high (empty = model default). low = fast scans/chat.
GEMINI_THINKING_LEVEL=low

# ---- Mock mode: true = no Gemini key and no model download needed ----
MOCK_AI=false

# ---- Transfer-learned classifier ----
CLASSIFIER_ENABLED=true
CLASSIFIER_MODEL_ID=nateraw/food
CLASSIFIER_TOP_K=3

# ---- Uploads ----
MAX_UPLOAD_MB=8
STORAGE_DIR=./storage/uploads

# ---- Limits ----
RATE_LIMIT_AI=20/minute
CHAT_HISTORY_TURNS=20
CHAT_MAX_TOOL_ROUNDS=4

# ---- Web frontend (served at /app) ----
FRONTEND_DIR=./frontend
